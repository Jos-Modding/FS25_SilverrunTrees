<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="ponderosaPineSapling01_pallet.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.13"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/maps/trees/saplings/dummy/planterBox_diffuse.png"/>
    <File fileId="2" filename="$data/maps/trees/saplings/dummy/planterBox_normal.png"/>
    <File fileId="3" filename="$data/maps/trees/saplings/dummy/planterBox_specular.png"/>
    <File fileId="4" filename="$data/shaders/placeableShader.xml"/>
    <File fileId="10" filename="ponderosaPineSapling_alpha.png"/>
    <File fileId="7" filename="ponderosaPineSapling_diffuse.png"/>
    <File fileId="9" filename="ponderosaPineSapling_fmask.png"/>
    <File fileId="8" filename="ponderosaPineSapling_normal.png"/>
  </Files>


  <Materials>
    <Material name="planterBox_mat" materialId="5" customShaderId="4" customShaderVariation="mergeChildren_hideByIndex">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="ponderosaPineSapling_mat" materialId="6" customShaderId="4" customShaderVariation="mergeChildren_hideByIndex_alphaMap">
      <Texture fileId="7"/>
      <Normalmap fileId="8"/>
      <Glossmap fileId="9"/>
      <Custommap name="alphaMap" fileId="10"/>
