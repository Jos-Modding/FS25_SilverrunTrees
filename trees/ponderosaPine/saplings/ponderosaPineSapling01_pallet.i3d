  </Materials>


  <Shapes externalShapesFile="ponderosaPineSapling01_pallet.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="ponderosaPineSaplings" clipDistance="300" nodeId="10">
      <Shape name="saplingBoxes" shapeId="1" clipDistance="300" nodeId="11" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="saplings" shapeId="2" clipDistance="300" nodeId="12" castsShadows="true" receiveShadows="true" doubleSided="true" materialIds="6"/>
    </TransformGroup>
  </Scene>

</i3D>
