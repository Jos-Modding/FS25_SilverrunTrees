<modDesc descVersion="110">
    <author>Jos</author>
    <version>1.0.0.0</version>
    <title>
        <en>Silverrun Trees</en>
        <de>Silverrun Bäume</de>
    </title>
    <description>
        <en><![CDATA[Adds trees from Silverrun Forest to any map. Giant Sequoia, Pagoda Dogwood, Ponderosa Pine, and Pine.

All trees can be planted or placed through the build menu.
]]>
        </en>
        <de><![CDATA[Fügt jeder Karte Bäume aus dem Silberlaufwald hinzu. Riesenmammutbaum, Wechselblättriger Hartriegel, Ponderosa-Kiefer und Kiefer.

Alle Bäume können über das Baumenü gepflanzt oder platziert werden.
]]>
        </de>
    </description>
    <iconFilename>icon_silverrunTrees.dds</iconFilename>
    <multiplayer supported="true"/>
    <extraSourceFiles>
        <sourceFile filename="src/main.lua"/>
    </extraSourceFiles>
